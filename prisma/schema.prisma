generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============ 用户（销售人员/部门管理员） ============
model users {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name     String  @db.VarChar(255)
  email    String  @unique
  password String
  role     String? @default("sales") @db.VarChar(20) // admin=销售总管看全部, sales=销售人员只看自己的

  crm_leads                       crm_lead[]
  crm_opportunities               crm_opportunity[]                  @relation("opportunity_sales")
  crm_opportunities_delivery      crm_opportunity[]                  @relation("opportunity_delivery")
  crm_customers                   crm_customer[]
  crm_follow_ups                  crm_follow_up[]                    @relation("follow_up_creator")
  crm_follow_ups_updated          crm_follow_up[]                    @relation("follow_up_updater")
  crm_lead_notifications_as_old   crm_lead_assignment_notification[] @relation("notification_old_sales")
  crm_lead_notifications_as_new   crm_lead_assignment_notification[] @relation("notification_new_sales")
  crm_lead_notifications_created  crm_lead_assignment_notification[] @relation("notification_creator")
  crm_customer_materials_uploaded crm_customer_material[]
}

/// 注册/找回密码等场景的邮箱验证码，单次有效、15 分钟过期
model email_verification_code {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(8)
  purpose   String   @default("signup") @db.VarChar(20)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([email, purpose])
  @@index([email, purpose])
  @@map("email_verification_codes")
}

// ============ CRM 四张表 ============

/// 线索管理：总池子来源，状态更新后可转入商机
model crm_lead {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerName   String   @map("customer_name") @db.VarChar(255)
  nickname       String?  @db.VarChar(100)
  /// 主要联系人姓名（如“张三”、“李总”），用于和客户名称区分
  contactPerson  String?  @map("contact_person") @db.VarChar(100)
  /// 主要联系人邮箱
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  city           String?  @db.VarChar(100)
  address        String?  @db.VarChar(500)
  industry       String?  @db.VarChar(100)
  leadSource     String?  @map("lead_source") @db.VarChar(100)
  /// 主要联系方式（手机号）
  contactPhone   String?  @map("contact_phone") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  customerTier   String?  @map("customer_tier") @db.VarChar(50)
  /// 线索备注 / 需求简要描述
  remark         String?  @db.VarChar(500)
  salesPersonId  String?  @map("sales_person_id") @db.Uuid
  status         String   @default("未跟进") @db.VarChar(50) // 未跟进|跟进中|有意向|无意向
  isKeyFocus     Boolean  @default(false) @map("is_key_focus") // 是否重点关注
  keyFocusByAdmin Boolean  @default(false) @map("key_focus_by_admin") // true=管理员标的，蓝色展示且 sales 不可取消
  /// 导入来源（可存文件名/渠道名，如“百度推广-2025Q1”）
  importSource   String?  @map("import_source") @db.VarChar(100)
  /// 其他扩展字段，存放 Excel 中未映射到规范字段的所有列
  extraFields    Json?    @map("extra_fields")

  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6) // 软删除时间，null 表示未删除

  salesPerson             users?                             @relation(fields: [salesPersonId], references: [id])
  opportunity             crm_opportunity?
  followUps               crm_follow_up[] // 该线索下的所有跟进记录
  assignmentNotifications crm_lead_assignment_notification[] // 该线索的销售人员变更通知

  @@index([status])
  @@index([salesPersonId])
  @@map("crm_leads")
}

/// 商机管理：来源于线索（有意向时转入），状态更新后可转入客户
model crm_opportunity {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String    @db.VarChar(255)
  leadId            String?   @unique @map("lead_id") @db.Uuid
  productType       String?   @map("product_type") @db.VarChar(100)
  status            String    @default("初步沟通") @db.VarChar(50) // 初步沟通|方案确认|待签约|已赢单|已丢单
  amount            Decimal?  @db.Decimal(12, 2)
  contactPhone      String?   @map("contact_phone") @db.VarChar(20) // 联系方式（手机号，从线索继承）
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  salesPersonId     String?   @map("sales_person_id") @db.Uuid
  deliveryPersonId  String?   @map("delivery_person_id") @db.Uuid
  lostReason        String?   @map("lost_reason") @db.VarChar(500)
  isKeyFocus        Boolean   @default(false) @map("is_key_focus") // 从线索继承
  keyFocusByAdmin   Boolean   @default(false) @map("key_focus_by_admin") // 从线索继承，admin 标为蓝星

  lead           crm_lead?       @relation(fields: [leadId], references: [id])
  salesPerson    users?          @relation("opportunity_sales", fields: [salesPersonId], references: [id])
  deliveryPerson users?          @relation("opportunity_delivery", fields: [deliveryPersonId], references: [id])
  customer       crm_customer?
  followUps      crm_follow_up[]

  @@index([status])
  @@index([salesPersonId])
  @@index([leadId])
  @@map("crm_opportunities")
}

/// 客户管理：来源于商机（待签约/已赢单时转入）
model crm_customer {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String    @db.VarChar(255)
  nickname             String?   @db.VarChar(100)
  city                 String?   @db.VarChar(100)
  firstMaintenanceDate DateTime?  @map("first_maintenance_date") @db.Date
  status               String    @default("已签约") @db.VarChar(50) // 预备签约|已签约|流失
  industry             String?   @db.VarChar(100)
  employeeCount        String?   @map("employee_count") @db.VarChar(50)
  tags                 String?   @db.VarChar(500)
  mainProducts         String?   @map("main_products") @db.VarChar(500)
  contactPhone         String?   @map("contact_phone") @db.VarChar(20) // 联系方式（手机号，从商机/线索继承）
  opportunityId        String?   @unique @map("opportunity_id") @db.Uuid
  actualAmount         Decimal?  @map("actual_amount") @db.Decimal(12, 2) // 实际成交金额（仅已签约客户需要）
  salesPersonId        String?   @map("sales_person_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  isKeyFocus           Boolean   @default(false) @map("is_key_focus") // 从商机/线索继承
  keyFocusByAdmin      Boolean   @default(false) @map("key_focus_by_admin") // 从商机/线索继承，admin 标为蓝星

  opportunity crm_opportunity?        @relation(fields: [opportunityId], references: [id])
  salesPerson users?                  @relation(fields: [salesPersonId], references: [id])
  followUps   crm_follow_up[]
  materials   crm_customer_material[]

  @@index([status])
  @@index([salesPersonId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("crm_customers")
}

/// 客户资料（Vercel Blob）：每个客户可上传多份文件，元数据存 DB，文件存 Blob
model crm_customer_material {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  blobUrl      String   @map("blob_url") @db.VarChar(1024) // Vercel Blob 返回的 url
  pathname     String?  @map("pathname") @db.VarChar(512) // Blob 存储路径，用于 del()
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     Int      @map("file_size") @db.Integer
  contentType  String?  @map("content_type") @db.VarChar(128)
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid

  customer   crm_customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy users?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("crm_customer_materials")
}

/// 跟进记录：关联线索、客户或商机
model crm_follow_up {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content       String   @db.Text
  followUpById  String   @map("follow_up_by_id") @db.Uuid
  followDate    DateTime @map("follow_date") @db.Date
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  summary       String?  @db.VarChar(500)
  nextStep      String?  @map("next_step") @db.VarChar(500)
  customerNeeds String?  @map("customer_needs") @db.VarChar(500)
  status        String?  @db.VarChar(50)
  leadId        String?  @map("lead_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid

  // 审计字段
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(6)
  updatedById       String?   @map("updated_by_id") @db.Uuid
  isSystemGenerated Boolean   @default(false) @map("is_system_generated") // 是否为系统自动生成（状态变更时）
  /// 流转类型：删除该条跟进时若存在则联动撤回业务数据。lead_to_opportunity=撤回线索转商机；opportunity_to_customer=撤回商机转客户
  transitionType    String?   @map("transition_type") @db.VarChar(32)

  followUpBy  users                 @relation("follow_up_creator", fields: [followUpById], references: [id])
  updatedBy   users?                @relation("follow_up_updater", fields: [updatedById], references: [id])
  lead        crm_lead?             @relation(fields: [leadId], references: [id])
  customer    crm_customer?         @relation(fields: [customerId], references: [id])
  opportunity crm_opportunity?      @relation(fields: [opportunityId], references: [id])
  images      crm_follow_up_image[]

  @@index([leadId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([followDate])
  @@index([createdAt])
  @@map("crm_follow_ups")
}

/// 跟进记录图片（Vercel Blob）：每条跟进可有多张图片，按需加载
model crm_follow_up_image {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followUpId  String   @map("follow_up_id") @db.Uuid
  blobUrl     String   @map("blob_url") @db.VarChar(1024)
  pathname    String?  @map("pathname") @db.VarChar(512)
  fileName    String   @map("file_name") @db.VarChar(255)
  fileSize    Int      @map("file_size") @db.Integer
  contentType String?  @map("content_type") @db.VarChar(128)
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  followUp crm_follow_up @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("crm_follow_up_images")
}

/// 线索销售人员变更通知：记录每次销售人员变更，用于发送邮件通知
model crm_lead_assignment_notification {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId     String @map("lead_id") @db.Uuid
  changeType String @map("change_type") @db.VarChar(20) // "assigned" | "reassigned" | "unassigned"

  // 变更前后的销售人员
  oldSalesPersonId String? @map("old_sales_person_id") @db.Uuid
  newSalesPersonId String? @map("new_sales_person_id") @db.Uuid

  // 通知状态
  notified   Boolean   @default(false)
  notifiedAt DateTime? @map("notified_at") @db.Timestamp(6)

  // 审计字段
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy String   @map("created_by") @db.Uuid

  // 关联
  lead           crm_lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldSalesPerson users?   @relation("notification_old_sales", fields: [oldSalesPersonId], references: [id], onDelete: SetNull)
  newSalesPerson users?   @relation("notification_new_sales", fields: [newSalesPersonId], references: [id], onDelete: SetNull)
  operator       users    @relation("notification_creator", fields: [createdBy], references: [id])

  @@index([leadId])
  @@index([oldSalesPersonId])
  @@index([newSalesPersonId])
  @@index([notified])
  @@index([createdAt])
  @@map("crm_lead_assignment_notifications")
}

// ============ 以下为旧表（可后续清理） ============
model Customer {
  id       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name     String    @db.VarChar(255)
  email    String    @db.VarChar(255)
  imageUrl String    @map("image_url") @db.VarChar(255)
  invoices Invoice[]

  @@map("customers")
}

model Invoice {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  amount     Int
  status     String   @db.VarChar(255)
  date       DateTime @db.Date
  customer   Customer @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Revenue {
  month   String @unique @db.VarChar(4)
  revenue Int

  @@map("revenue")
}

model scm_order_events {
  id              BigInt    @id @default(autoincrement())
  po_id           BigInt
  event_type      String    @db.VarChar(50)
  shipped_qty     Int?      @default(0)
  logistics_no    String?   @db.VarChar(100)
  evidence_photos String?
  operator_name   String?   @db.VarChar(50)
  event_time      DateTime? @default(now()) @db.Timestamp(6)

  @@index([po_id], map: "idx_event_po_id")
  @@index([event_time], map: "idx_event_time")
  @@index([event_type], map: "idx_event_type")
}

model scm_purchase_order_items {
  id               BigInt   @id @default(autoincrement())
  po_id            BigInt
  sku_code         String   @db.VarChar(50)
  product_name     String   @db.VarChar(100)
  spec             String?  @db.VarChar(200)
  quantity         Int
  unit             String?  @default("PCS") @db.VarChar(20)
  unit_price       Decimal? @default(0.00) @db.Decimal(12, 2)
  carton_size      String?  @db.VarChar(50)
  unit_cbm         Decimal? @db.Decimal(8, 4)
  shipped_quantity Int?     @default(0)

  @@index([po_id], map: "idx_item_po_id")
}

model scm_purchase_orders {
  id                      BigInt    @id @default(autoincrement())
  po_number               String    @unique(map: "uk_po_number") @db.VarChar(50)
  supplier_id             BigInt
  status                  Int       @default(10) @db.SmallInt
  order_date              DateTime  @db.Date
  requested_delivery_date DateTime  @db.Date
  confirmed_delivery_date DateTime? @db.Date
  actual_ship_date        DateTime? @db.Timestamp(6)
  currency                String?   @default("USD") @db.VarChar(10)
  total_amount            Decimal?  @default(0.00) @db.Decimal(12, 2)
  total_cbm               Decimal?  @db.Decimal(10, 3)
  incoterms               String?   @default("FOB") @db.VarChar(20)
  loading_port            String?   @db.VarChar(50)
  rejection_reason        String?   @db.VarChar(255)
  remark                  String?
  source_type             String?   @default("EXCEL_IMPORT") @db.VarChar(20)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)

  @@index([status], map: "idx_po_status")
  @@index([supplier_id], map: "idx_po_supplier")
}

model scm_suppliers {
  id              BigInt    @id @default(autoincrement())
  supplier_code   String    @db.VarChar(50)
  erp_vendor_code String?   @db.VarChar(50)
  full_name       String    @db.VarChar(100)
  short_name      String    @db.VarChar(50)
  contact_name    String?   @db.VarChar(50)
  contact_mobile  String    @unique(map: "uk_mobile") @db.VarChar(20)
  main_category   String?   @db.VarChar(50)
  province        String?   @db.VarChar(50)
  status          Int?      @default(1) @db.SmallInt
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([erp_vendor_code], map: "idx_erp_code")
}
